# Copy to .env and fill in. .env is gitignored.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=bloom_studio
# OpenRouter API key (https://openrouter.ai/keys). Required when LLM_BACKEND=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openai/gpt-5.5
# Comma-separated catalogue offered by GET /models (Settings pane model picker).
AVAILABLE_MODELS=openai/gpt-5.5,openai/gpt-4o-mini,meta-llama/llama-3.2-3b-instruct:free
# Provider mode: "live" = real OpenRouter + real ComfyUI; "replay" = recorded-real fixtures (offline, deterministic).
PROVIDER_MODE=live
REPLAY_TOKEN_DELAY=0.0
