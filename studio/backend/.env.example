# Copy to .env and fill in. .env is gitignored.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=bloom_studio
# OpenRouter API key (https://openrouter.ai/keys). Required when LLM_BACKEND=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=openai/gpt-5.5
# NB: OpenRouter spells Anthropic point releases with a DOT (claude-sonnet-4.6),
# so the dashed form 404s. sonnet-5 is the current model at the critic's tier.
CRITIC_MODEL=anthropic/claude-sonnet-5
# Comma-separated catalogue offered by GET /models (Settings pane model picker).
# Every slug here must resolve on OpenRouter - the picker offers them verbatim.
AVAILABLE_MODELS=openai/gpt-5.5,openai/gpt-4o-mini,openai/gpt-oss-20b:free
# Provider mode: "live" = real OpenRouter + real ComfyUI; "replay" = recorded-real fixtures (offline, deterministic).
PROVIDER_MODE=live
REPLAY_TOKEN_DELAY=0.0
# ComfyUI base URL. Defaults to a local GPU; point it at a LAN box if ComfyUI
# runs elsewhere, e.g. COMFYUI_URL=http://192.168.1.110:8188
COMFYUI_URL=http://127.0.0.1:8188
